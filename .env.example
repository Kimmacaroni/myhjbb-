# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 절대 커밋하지 마세요.

# ── 필수 ──────────────────────────────────────────────
# 디스코드 개발자 포털 > Bot > Reset Token 으로 발급받은 값
DISCORD_TOKEN=

# 봇을 사용할 서버 ID. 넣어두면 슬래시 명령어가 즉시 반영됩니다. (권장)
GUILD_ID=

# 경험치/칭호 데이터가 저장될 파일. 재시작 후에도 남는 경로여야 합니다.
DB_PATH=bot.db

# ── 식단 브리핑 ───────────────────────────────────────
MENU_CHANNEL_ID=1470221003597680773
MENU_HOUR_KST=6
# 상시 실행 봇이 식단을 보내지 않게 하려면 0 (GitHub Actions를 계속 쓰는 경우)
ENABLE_MENU_TASK=1

# ── 경험치 설정 (생략 시 기본값) ──────────────────────
# 채팅 1회당 지급량(범위)과 재지급 대기 시간(초)
CHAT_XP_MIN=15
CHAT_XP_MAX=25
CHAT_XP_COOLDOWN=60

# 통화방 1분당 지급량 / 최소 인원 / 자체 음소거 시 제외 여부
VOICE_XP_PER_MINUTE=5
VOICE_MIN_MEMBERS=2
VOICE_IGNORE_SELF_MUTED=1

# ── 레벨 · 칭호 ───────────────────────────────────────
# 레벨업 알림 채널. 비우면 마지막으로 대화한 채널에 보냅니다.
LEVEL_UP_CHANNEL_ID=
# 1이면 최고 등급 칭호 1개만 유지, 0이면 획득한 칭호를 전부 유지
KEEP_ONLY_HIGHEST_TITLE=1
