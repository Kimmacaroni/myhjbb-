# 이 파일을 복사해 .env로 저장하고 값을 채우세요.
# (.env는 .gitignore에 이미 등록되어 있어 커밋되지 않습니다.)

# ── 필수 ──────────────────────────────────────────────
DISCORD_TOKEN=

# 명령어를 등록할 서버 ID. 비워두면 전역 등록(반영까지 최대 1시간).
GUILD_ID=

# 경험치/경고 데이터가 저장될 SQLite 파일 경로. 재시작 후에도 남는 위치로 지정하세요.
DB_PATH=bot.db

# ── 식단 브리핑 ───────────────────────────────────────
ENABLE_MENU_TASK=1
MENU_CHANNEL_ID=
MENU_HOUR_KST=6

# ── 채팅 경험치 ───────────────────────────────────────
CHAT_XP_MIN=15
CHAT_XP_MAX=25
CHAT_XP_COOLDOWN=60

# ── 통화방(음성) 경험치 ───────────────────────────────
VOICE_XP_PER_MINUTE=5
VOICE_MIN_MEMBERS=2
VOICE_IGNORE_SELF_MUTED=1

# ── 레벨 / 칭호 ───────────────────────────────────────
LEVEL_UP_CHANNEL_ID=
KEEP_ONLY_HIGHEST_TITLE=1
# 예) LEVEL_ROLES=5:123456789012345678,10:234567890123456789
LEVEL_ROLES=

# ── 신규 멤버 환영 ────────────────────────────────────
WELCOME_CHANNEL_ID=

# ── 운영 로그 ─────────────────────────────────────────
MOD_LOG_CHANNEL_ID=
