# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 절대 커밋하지 마세요.

# ── 필수 ──────────────────────────────────────────────
# 디스코드 개발자 포털 > Bot > Reset Token 으로 발급받은 값
DISCORD_TOKEN=

# 명령어를 등록할 서버 ID. 비워두면 참여 중인 모든 서버에 자동으로 등록됩니다.
# 특정 서버에만 등록하고 싶을 때만 채우세요.
GUILD_ID=

# 관리자 명령의 봇 소유자 예외 ID. 여러 개면 쉼표로 구분하며, 비우면 예외 없음.
BOT_OWNER_IDS=

# 경험치/칭호 데이터가 저장될 파일. 재시작 후에도 남는 경로여야 합니다.
DB_PATH=bot.db

# ── 식단 브리핑 ───────────────────────────────────────
# 채널은 디스코드에서 /식단채널설정 명령어로 지정합니다 (여기서 설정할 필요 없음).
MENU_HOUR_KST=6
# 상시 실행 봇이 식단을 보내지 않게 하려면 0 (GitHub Actions를 계속 쓰는 경우)
ENABLE_MENU_TASK=1

# ── 경험치 설정 (생략 시 기본값) ──────────────────────
# 채팅 1회당 지급량(범위)과 재지급 대기 시간(초)
CHAT_XP_MIN=15
CHAT_XP_MAX=25
CHAT_XP_COOLDOWN=60

# 통화방 1분당 지급량 / 최소 인원 / 자체 음소거 시 제외 여부
VOICE_XP_PER_MINUTE=5
VOICE_MIN_MEMBERS=2
VOICE_IGNORE_SELF_MUTED=1

# ── 레벨 · 칭호 ───────────────────────────────────────
# 레벨업 알림 채널. 비우면 마지막으로 대화한 채널에 보냅니다.
LEVEL_UP_CHANNEL_ID=
# 1이면 최고 등급 칭호 1개만 유지, 0이면 획득한 칭호를 전부 유지
KEEP_ONLY_HIGHEST_TITLE=1

# ── 교통정보(고속도로 정체 구간) 알림 ─────────────────
# 채널은 디스코드에서 /교통정보채널설정 명령어로 지정합니다.
# 한국도로공사 Open API(data.ex.co.kr) 인증키. 무료로 발급받을 수 있으며,
# 비워두면 교통정보 기능이 조용히 꺼집니다.
HIGHWAY_API_KEY=
# 새로 정체가 시작됐는지 확인하는 주기(분)
TRAFFIC_POLL_MINUTES=30
# 상시 실행 봇이 교통정보 알림을 보내지 않게 하려면 0
ENABLE_TRAFFIC_TASK=1
